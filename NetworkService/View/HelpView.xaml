<UserControl x:Class="NetworkService.View.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Margin="14">
        <StackPanel>

            <TextBlock Text="Help" Style="{StaticResource SectionHeaderStyle}" FontSize="26" Margin="0,0,0,16"/>

            <TextBlock Text="Network Display View"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>

            <TextBlock TextWrapping="Wrap"
                       Margin="0,5,0,16"
                       Text="Drag servers from the Available servers list to the network grid. Use Auto to automatically place all remaining servers. Use Connect to select two servers and draw a connection line between them. Right-click a server, or drag it back onto the list, to remove it from the grid."/>

            <TextBlock Text="Network Entities View"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>

            <TextBlock TextWrapping="Wrap"
                       Margin="0,5,0,16"
                       Text="Use this view to add, delete, search and undo server changes. To add a server, select a type and click Add. To delete a server, select it in the table and click Delete, then confirm the action."/>

            <TextBlock Text="Measurement Graph View"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>

            <TextBlock TextWrapping="Wrap"
                       Margin="0,5,0,16"
                       Text="Use the ComboBox to select a server. The graph shows the last five measurements. Green circles represent valid values between 45% and 75%. Red circles represent invalid values."/>

            <TextBlock Text="Shortcuts"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>

            <TextBlock TextWrapping="Wrap"
                       Margin="0,5,0,16"
                       Text="Ctrl + E opens Entities View. Ctrl + G opens Graph View."/>

        </StackPanel>
    </ScrollViewer>
</UserControl>