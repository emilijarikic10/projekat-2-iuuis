<UserControl x:Class="NetworkService.View.MeasurementGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="8" Background="{StaticResource WindowBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="8"
                BorderBrush="{StaticResource BorderColorBrush}"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,8">

            <DockPanel>
                <TextBlock Text="Measurement Graph"
                           Style="{StaticResource SectionHeaderStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"
                           DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Border Background="#D6F5E1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                        <TextBlock Text="Valid (45-75%)" FontSize="11" FontWeight="Bold" Foreground="#2EA043"/>
                    </Border>
                    <Border Background="#FFDCDC" CornerRadius="4" Padding="6,3">
                        <TextBlock Text="Invalid" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Server:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0"/>

                    <ComboBox x:Name="cbEntities"
                              Width="190"
                              SelectionChanged="cbEntities_SelectionChanged"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="10"
                BorderBrush="{StaticResource BorderColorBrush}"
                BorderThickness="1"
                Padding="8">

            <Canvas x:Name="GraphCanvas"
                    Background="White"/>

        </Border>

    </Grid>
</UserControl>