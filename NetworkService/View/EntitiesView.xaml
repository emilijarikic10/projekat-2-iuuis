<UserControl x:Class="NetworkService.View.EntitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">

            <TextBlock Text="Network Entities"
                       Style="{StaticResource SectionHeaderStyle}"
                       Margin="0,0,0,10"/>

            <WrapPanel Margin="0,0,0,2">

                <TextBlock Text="Type:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,8,0"/>

                <ComboBox Width="150"
                          ItemsSource="{Binding Types}"
                          SelectedItem="{Binding CurrentForm.SelectedType}"
                          DisplayMemberPath="Name"/>

                <Button Content="Add"
                        Width="90"
                        ToolTip="Add a new server of the selected type"
                        Command="{Binding AddCommand}"/>

                <Button Content="Delete"
                        Width="90"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Delete the selected server (Ctrl+E to focus this view)"
                        Click="Delete_Click"/>

                <Button Content="Undo"
                        Width="90"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Undo the last add/delete action"
                        Command="{Binding UndoCommand}"/>
            </WrapPanel>

            <TextBlock Text="{Binding CurrentForm.ValidationErrors[SelectedType]}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,2,0,8"/>

            <WrapPanel Margin="0,0,0,8">

                <RadioButton Content="Name"
                             IsChecked="{Binding SearchByName}"
                             GroupName="Search"/>

                <RadioButton Content="Type"
                             IsChecked="{Binding SearchByType}"
                             GroupName="Search"/>

                <TextBox Width="140"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Content="Search"
                        Width="85"
                        Command="{Binding SearchCommand}"/>

                <Button Content="Reset"
                        Width="80"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ResetSearchCommand}"/>
            </WrapPanel>

            <WrapPanel>

                <Button Content="Save Search"
                        Width="115"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Save the current search so it can be reused later"
                        Command="{Binding SaveSearchCommand}"/>

                <ComboBox Width="180"
                          ItemsSource="{Binding SavedSearches}"
                          SelectedItem="{Binding SelectedSavedSearch}"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FilteredEntities}"
                  SelectedItem="{Binding SelectedEntity}"
                  AutoGenerateColumns="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="110"/>
                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type.Name}" Width="120"/>
                <DataGridTemplateColumn Header="Load" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Value, StringFormat='{}{0:0.0}%'}"
                                       Foreground="{Binding StatusColor}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="DeleteConfirmationPanel"
                Grid.Row="2"
                Background="#FFF6F6"
                BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,10,0,0"
                Visibility="Collapsed">

            <StackPanel>
                <TextBlock Text="Delete selected server?"
                           FontWeight="Bold"
                           FontSize="15"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Yes, delete"
                            Width="110"
                            Click="ConfirmDelete_Click"/>

                    <Button Content="Cancel"
                            Width="90"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelDelete_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>