<Window x:Class="NetworkService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:NetworkService.View"
        xmlns:notifications="clr-namespace:Notification.Wpf.Controls;assembly=Notification.Wpf"
        Title="Network Service - Control Room"
        Height="760"
        Width="1320"
        MinHeight="650"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        KeyDown="Window_KeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="6"
                    Margin="0,0,8,0"
                    BorderBrush="{StaticResource BorderColorBrush}"
                    BorderThickness="1">

                <view:NetworkDisplayView/>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="8"
                    BorderBrush="{StaticResource BorderColorBrush}"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,4,0,4">

                        <Button Content="Entities"
                                Style="{StaticResource NavButtonStyle}"
                                ToolTip="Shortcut: Ctrl + E"
                                Click="Entities_Click"/>

                        <Button Content="Graph"
                                Style="{StaticResource NavButtonStyle}"
                                ToolTip="Shortcut: Ctrl + G"
                                Click="Graph_Click"/>

                        <Button Content="Help"
                                Style="{StaticResource NavButtonStyle}"
                                ToolTip="Application help"
                                Click="Help_Click"/>
                    </StackPanel>

                    <ContentControl x:Name="MainContent"
                                    Grid.Row="1"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource PrimaryDarkBrush}"
                CornerRadius="6"
                Margin="0,8,0,0"
                Padding="10,4">

            <TextBlock Text="System running  |  Measurements active  |  Valid range: 45-75%  |  Ctrl+E Entities  |  Ctrl+G Graph"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="13"
                       VerticalAlignment="Center"/>
        </Border>

        <notifications:NotificationArea x:Name="WindowNotificationArea"
                                         Grid.RowSpan="2"
                                         Panel.ZIndex="1000"
                                         MaxItems="3"
                                         Position="TopRight"/>
    </Grid>
</Window>